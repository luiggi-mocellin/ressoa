{
  "name": "ressoa-desktop",
  "productName": "Ressoa",
  "version": "1.3.0",
  "description": "Ressoa — chamadas de voz, vídeo e tela em servidores.",
  "main": "main.js",
  "author": "Ressoa",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "app.ressoa.desktop",
    "productName": "Ressoa",
    "files": ["main.js", "preload.js", "picker-preload.js", "picker.html", "setup.html", "icon.png"],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": { "artifactName": "${productName}-Setup-${version}.${ext}" },
    "publish": [{ "provider": "github", "owner": "luiggi-mocellin", "repo": "ressoa", "releaseType": "release" }]
  }
}
